{
  "name": "tradingcopilot",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "services/frontend",
    "services/backend"
  ],
  "scripts": {
    "backend:dev": "npm --prefix services/backend run dev",
    "backend:build": "npm --prefix services/backend run build",
    "backend:test": "npm --prefix services/backend run test -- --run",
    "frontend:dev": "npm --prefix services/frontend run dev",
    "frontend:build": "npm --prefix services/frontend run build",
    "test": "npm run backend:test"
  }
}
